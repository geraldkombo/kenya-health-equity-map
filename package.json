{
  "name": "kenya-health-equity-map",
  "version": "1.0.0",
  "private": true,
  "description": "Map-first civic intelligence platform for health equity across Kenya's 47 counties",
  "repository": "github.com/geraldkombo/kenya-health-equity-map",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-icons.mjs && node -e \"const fs=require('fs');const s='./data';const d='./public/data';fs.rmSync(d,{recursive:true,force:true});fs.cpSync(s,d,{recursive:true})\"",
    "dev": "node -e \"const fs=require('fs');const s='./data';const d='./public/data';fs.rmSync(d,{recursive:true,force:true});fs.cpSync(s,d,{recursive:true})\" && next dev",
    "build": "next build",
    "start": "npx serve out",
    "etl:extract": "npx tsx scripts/etl/1-extract-kmhfr.ts",
    "etl:knbs": "npx tsx scripts/etl/2-extract-knbs.ts",
    "etl:spatial": "npx tsx scripts/etl/3-extract-spatial.ts",
    "etl:build": "npx tsx scripts/etl/4-build-snapshot.ts",
    "etl": "npm run etl:extract && npm run etl:knbs && npm run etl:spatial && npm run etl:build",
    "lint": "next lint",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "csv-parse": "^7.0.3",

    "fuse.js": "^7.5.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.4",
    "pmtiles": "^4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-to-print": "^3.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "husky": "^9.1.7",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
