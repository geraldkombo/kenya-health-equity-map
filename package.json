{
  "name": "kenya-health-equity-map",
  "version": "1.0.0",
  "private": true,
  "description": "Map-first civic intelligence platform for health equity across Kenya's 47 counties",
  "repository": "github.com/geraldkombo/kenya-health-equity-map",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-icons.mjs && node -e \"const fs=require('fs');const s='./data';const d='./public/data';fs.rmSync(d,{recursive:true,force:true});fs.cpSync(s,d,{recursive:true})\" && node scripts/copy-maplibre-worker.mjs",
    "dev": "node -e \"const fs=require('fs');const s='./data';const d='./public/data';fs.rmSync(d,{recursive:true,force:true});fs.cpSync(s,d,{recursive:true})\" && next dev",
    "build": "next build",
    "start": "npx serve out",
    "etl:extract": "npx tsx scripts/etl/1-extract-kmhfr.ts",
    "etl:knbs": "npx tsx scripts/etl/2-extract-knbs.ts",
    "etl:spatial": "npx tsx scripts/etl/3-extract-spatial.ts",
    "etl:build": "npx tsx scripts/etl/4-build-snapshot.ts",
    "etl": "npm run etl:extract && npm run etl:knbs && npm run etl:spatial && npm run etl:build",
    "lint": "next lint",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "csv-parse": "^6.2.1",
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^6.4.1",
    "next": "15.5.28",
    "pmtiles": "^4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-to-print": "^3.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.26.0",
    "eslint-config-next": "15.5.28",
    "husky": "^9.1.7",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "tar": "^7.5.19"
  }
}
